doctype html
html
  head
    title= title
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel='stylesheet', href='/css/style.css')
  body
    h1 Custom Object Table
    a(href='/update-cobj') Add\/Update this table
    if records && records.length
      table
        thead
          tr
            th= col1
            th= col2
            th= col3
        tbody
          each record in records
            tr
              td= record.properties[prop1] || '—'
              td= record.properties[prop2] || '—'
              td= record.properties[prop3] || '—'
    else
      p No records found. Add one using the link above!
